<IfModule mod_expires.c>
  ExpiresActive On
  <FilesMatch "\.(?:css|js|mjs|webp|png|jpg|jpeg|svg|gif|woff2?|ttf)$">
    ExpiresDefault "access plus 1 year"
  </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(?:css|js|mjs|webp|png|jpg|jpeg|svg|gif|woff2?|ttf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
